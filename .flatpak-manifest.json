{
  "app-id": "org.kde.ktimetracker",
  "runtime": "org.kde.Platform",
  "runtime-version": "5.15-25.08",
  "sdk": "org.kde.Sdk",
  "command": "ktimetracker",
  "rename-icon": "ktimetracker",
  "finish-args": [
    "--share=ipc",
    "--device=dri",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "ktimetracker",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DQT_MAJOR_VERSION=5"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
